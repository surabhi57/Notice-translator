SECRET_KEY=replace-with-a-long-random-secret
DATABASE_URL=sqlite:///./noticelens.db
CORS_ORIGINS=http://localhost:5173,https://notiq-wine.vercel.app
UPLOAD_DIR=uploads
SESSION_COOKIE_SECURE=false
# Use "none" only with SESSION_COOKIE_SECURE=true for cross-site production frontends.
SESSION_COOKIE_SAMESITE=lax
# Leave blank locally if Tesseract is on PATH. On Windows, set this to tesseract.exe.
# Render/Linux Docker deployment sets this automatically to /usr/bin/tesseract.
TESSERACT_CMD=
